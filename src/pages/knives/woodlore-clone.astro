---
import type { ImageMetadata } from 'astro'
import Card from '../../components/Card.astro'
import DrawOnScroll from '../../components/DrawOnScroll.astro'
import FadeImage from '../../components/FadeImage.astro'
import Gallery from '../../components/Gallery'
import InlineLink from '../../components/InlineLink.astro'
import WoodloreSkeletonSVG from '../../components/knives/WoodloreSkeletonSVG.astro'
import WoodloreSpineSVG from '../../components/knives/WoodloreSpineSVG.astro'
import WoodloreSVG from '../../components/knives/WoodloreSVG.astro'
import PageTitle from '../../components/PageTitle.astro'
import { SITE } from '../../data/site'
import bannerImg from '../../images/woodlore-clone-banner.jpg'
import Layout from '../../layouts/Layout.astro'
import { buildGalleryPhotosFromDir } from '../../utils/gallery'

const galleryPhotos = await buildGalleryPhotosFromDir(
	import.meta.glob<ImageMetadata>('../../images/woodlore-clone-images/*.jpg', {
		eager: true,
		import: 'default',
	}),
)
---

<Layout
	title="Woodlore Clone"
	description="The knife that started it all — my handmade take on the Woodlore bushcraft classic, in 4mm O1 tool steel with a tapered tang."
	keywords={['bushblade', 'knife', 'ray mears', 'alan wood', 'woodlore', 'bushcraft', 'handmade', 'carving']}
>
	<FadeImage src={bannerImg} alt="Woodlore Clone knife banner" class="w-full" layout="full-width" loading="eager" />
	<PageTitle pageTitle="Woodlore Clone" tagline="The design that inspired it all" />

	<div class="max-w-7xl mx-auto px-4">
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-8">
			<div class="md:col-start-1 md:row-start-1">
				<DrawOnScroll>
					<WoodloreSVG />
				</DrawOnScroll>
				<div class="my-4">
					<DrawOnScroll>
						<WoodloreSpineSVG />
					</DrawOnScroll>
				</div>
				<DrawOnScroll>
					<WoodloreSkeletonSVG />
				</DrawOnScroll>
			</div>
			<div class="md:col-start-2 md:row-start-1">
				<Card>
					<p>
						<strong>My version of the bushcraft classic.</strong> A great all
						round practical design and the knife that most inspired me to
						become a maker.
					</p>
					<ul class="mt-4 list-disc list-inside">
						<li>222mm overall length with a blade length of 112mm</li>
						<li>4mm thick O1 tool steel</li>
						<li>Hardened to ~ 59RC and double tempered</li>
						<li>Skeletonised and tapered tang for balance and weight reduction</li>
					<li>
						Prices start at £{SITE.prices.woodloreClone}{' '}
						{SITE.acceptingOrders ? (
							<>
								<InlineLink href="/contact">contact me</InlineLink> for further
								details
							</>
						) : (
							<>— currently not taking orders</>
						)}
					</li>
					</ul>
					<p class="mt-4">
						Browse the gallery below or check out even more images in the{' '}
						<InlineLink
							href="https://goo.gl/photos/3RDcLyQUAMJwYTtQ7"
							target="_blank"
							class="whitespace-nowrap"
						>
							Google Photos
						</InlineLink>{' '}
						album.
					</p>
				</Card>
			</div>
		</div>

		<div class="my-16">
			<Gallery client:load photos={galleryPhotos} />
		</div>
	</div>
</Layout>
