---
import type { ImageMetadata } from 'astro'
import Card from '../../components/Card.astro'
import DrawOnScroll from '../../components/DrawOnScroll.astro'
import FadeImage from '../../components/FadeImage.astro'
import Gallery from '../../components/Gallery'
import InlineLink from '../../components/InlineLink.astro'
import MidiSkeletonSVG from '../../components/knives/MidiSkeletonSVG.astro'
import MidiSpineSVG from '../../components/knives/MidiSpineSVG.astro'
import MidiSVG from '../../components/knives/MidiSVG.astro'
import PageTitle from '../../components/PageTitle.astro'
import { SITE } from '../../data/site'
import bannerImg from '../../images/banner01.jpg'
import Layout from '../../layouts/Layout.astro'
import { buildGalleryPhotosFromDir } from '../../utils/gallery'

const galleryPhotos = await buildGalleryPhotosFromDir(
	import.meta.glob<ImageMetadata>('../../images/midi-images/*.jpg', {
		eager: true,
		import: 'default',
	}),
)
---

<Layout
	title="Model 01 Midi"
	description="My own scaled-down, lightweight take on the Model 01 — 3mm O1 tool steel, skeletonised tang, around 118g with a wooden handle."
	keywords={['bushblade', 'knife', 'midi', 'model 01', 'bushcraft', 'handmade', 'carving']}
>
	<FadeImage src={bannerImg} alt="Model 01 Midi banner" class="w-full" layout="full-width" loading="eager" />
	<PageTitle pageTitle="Model 01 Midi" tagline="my design, my choice" />

	<div class="max-w-7xl mx-auto px-4">
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-8">
			<div class="md:col-start-1 md:row-start-1">
				<DrawOnScroll>
					<MidiSVG />
				</DrawOnScroll>
				<div class="my-4">
					<DrawOnScroll>
						<MidiSpineSVG />
					</DrawOnScroll>
				</div>
				<DrawOnScroll>
					<MidiSkeletonSVG />
				</DrawOnScroll>
			</div>
			<div class="md:col-start-2 md:row-start-1">
				<Card>
					<p>
						This is a scaled down version of my Model 01 which was{' '}
						<strong>originally based on the Mora Clipper.</strong> It is a very
						lightweight and compact, almost full sized bushcraft knife that
						fills the hand well. A knife of this design with a wooden handle{' '}
						<strong>weighs around 118g</strong> (220 with sheath)
					</p>
					<ul class="mt-4 list-disc list-inside">
						<li>Overall length is around 209mm with a blade length of 101mm</li>
						<li>3mm thick O1 tool steel</li>
						<li>Hardened to ~ 59RC and double tempered</li>
						<li>Skeletonised tang for balance and weight reduction</li>
					<li>
						Prices start at £{SITE.prices.midi}{' '}
						{SITE.acceptingOrders ? (
							<>
								<InlineLink href="/contact">contact me</InlineLink> for further
								details
							</>
						) : (
							<>— currently not taking orders</>
						)}
					</li>
					</ul>
					<p class="mt-4">
						Browse the gallery below or check out even more images in the{' '}
						<InlineLink
							href="https://goo.gl/photos/bA7zFLfduB66WumU6"
							target="_blank"
							class="whitespace-nowrap"
						>
							Google Photos
						</InlineLink>{' '}
						album.
					</p>
				</Card>
			</div>
		</div>

		<div class="my-16">
			<Gallery client:load photos={galleryPhotos} />
		</div>
	</div>
</Layout>
