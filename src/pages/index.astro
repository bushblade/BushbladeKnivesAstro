---
import { Image } from 'astro:assets'
import BannerImage from '../components/BannerImage.astro'
import BlockQuote from '../components/BlockQuote.astro'
import Gallery from '../components/Gallery'
import InlineLink from '../components/InlineLink.astro'
import PageTitle from '../components/PageTitle.astro'
import bannerImg from '../images/banner02.jpg'
import galleryImg01 from '../images/index-images/img01.jpg'
import galleryImg02 from '../images/index-images/img02.jpg'
import galleryImg03 from '../images/index-images/img03.jpg'
import galleryImg04 from '../images/index-images/img04.jpg'
import galleryImg05 from '../images/index-images/img05.jpg'
import galleryImg06 from '../images/index-images/img06.jpg'
import profileImg from '../images/me-allerthorpe.jpg'
import Layout from '../layouts/Layout.astro'
import { buildGalleryPhotos } from '../utils/gallery'
import { imageFormat } from '../utils/image'

// Gallery alt text: add a short description per photo for screen readers, e.g.
// { name: 'img01', alt: 'Finished Woodlore-style knife with curly birch handle', src: galleryImg01 }.
// `alt` is optional — omit it and the generic filename is used instead.
const gallerySources = [
	{ name: 'img01', src: galleryImg01 },
	{ name: 'img02', src: galleryImg02 },
	{ name: 'img03', src: galleryImg03 },
	{ name: 'img04', src: galleryImg04 },
	{ name: 'img05', src: galleryImg05 },
	{ name: 'img06', src: galleryImg06 },
]

const galleryPhotos = await buildGalleryPhotos(gallerySources)
---

<Layout
	title="Welcome to Bushblade"
	keywords={['ray mears', 'alan wood', 'bushcraft', 'handmade', 'knife', 'uk']}
>
	<BannerImage image={bannerImg} alt="Bushblade knives banner" />

	<div class="max-w-7xl mx-auto px-4">
		<PageTitle pageTitle="Welcome to Bushblade" tagline="handmade knives by Will Adams" />

		<div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-8">
			<div class="md:col-start-2 md:row-start-1">
				<Image
					src={profileImg}
					alt="Will Adams"
					title="Will Adams"
					class="w-full"
					width={800}
					loading="eager"
					format={imageFormat}
				/>
			</div>
			<div class="md:col-start-1 md:row-start-1">
				<BlockQuote>
				Having used and acquired many knives over the years, from a
				variety of brand name manufacturers and without sufficient funds to
				purchase my ideal knife I decided to try and make my own.
			</BlockQuote>
				<br />
				<p>
					<strong>I made my first knives in 2001</strong> yielding functional
					success in replicating the now famous Woodlore knives designed by Ray
					Mears and at the time made by Alan Wood. I still own these knives but
					the quality of my work has improved somewhat since the early days.
				</p>
				<p class="mt-4">
					<strong>I am a firm believer in form following function.</strong> I aim
					to make a functional tool that will be a pleasure to own and use for
					many years. The overall fit, finish and quality of work are of the
					utmost importance to me when making a knife. Each knife and sheath is
					handmade by me here in the UK, I do not currently outsource any part of
					the process.
				</p>
			</div>
		</div>

		<div class="text-center my-8">
			<p>
				I only spend a few days each week making knives as the majority of my
				time is dedicated to my twin girls. Please take a look around, and feel
				free to
				<InlineLink href="/contact">contact me</InlineLink>
				with any comments or enquiries.
			</p>
		<h2 class="text-red-error text-2xl mt-8">
			You must be over 18 years of age to order a knife.
		</h2>
	</div>

	<div class="my-16">
		<Gallery client:load photos={galleryPhotos} />
	</div>
</Layout>
