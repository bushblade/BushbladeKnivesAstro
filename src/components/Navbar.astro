---
import { isActive, leftLinks, rightLinks } from '../data/links'
import Facebook from './icons/Facebook.astro'
import Hamburger from './icons/Hamburger.astro'
import Instagram from './icons/Instagram.astro'
import Twitter from './icons/Twitter.astro'
import YouTube from './icons/YouTube.astro'
import Logo from './Logo.astro'
import MobileMenu from './MobileMenu.astro'

const currentPath = Astro.url.pathname

const socialLinks = [
	{
		href: 'https://www.facebook.com/Bushbladehandmadeknives/',
		icon: Facebook,
		hoverColor: 'hover:text-facebook',
		ariaLabel: 'Facebook (opens in new tab)',
	},
	{
		href: 'https://www.instagram.com/bushblade/',
		icon: Instagram,
		hoverColor: 'hover:text-instagram',
		ariaLabel: 'Instagram (opens in new tab)',
	},
	{
		href: 'https://x.com/Bushblade',
		icon: Twitter,
		hoverColor: 'hover:text-twitter',
		ariaLabel: 'Twitter / X (opens in new tab)',
	},
	{
		href: 'https://www.youtube.com/@bushbladehandmadeknives2528',
		icon: YouTube,
		hoverColor: 'hover:text-youtube',
		ariaLabel: 'YouTube (opens in new tab)',
	},
]
---

<div class="social-row h-14 bg-olive max-lg:hidden">
	<div class="flex items-center h-full px-4">
		<div class="flex items-center gap-3">
			{socialLinks.map(({ href, icon: Icon, hoverColor, ariaLabel }) => (
				<a {href} target="_blank" rel="noopener noreferrer" class={`${hoverColor} transition-colors`} aria-label={ariaLabel}>
					<Icon class="w-5 h-5" />
				</a>
			))}
		</div>
	</div>
</div>

<nav
	id="main-nav"
	class="bg-olive text-dark-gray sticky top-0 z-50 h-14 shadow-[0_4px_4px_rgba(0,0,0,0.3)]"
>
	<div
		class="absolute inset-0 flex items-center justify-center pointer-events-none z-10"
	>
		<a href="/" id="logo-link" class="pointer-events-auto block w-80">
			<Logo class="w-full h-auto" />
		</a>
	</div>

	<div class="h-14">
		<div
			class="grid grid-cols-[1fr_320px_1fr] items-stretch h-full text-xl italic tracking-wider"
		>
			<div class="flex items-center justify-center gap-6 max-lg:hidden">
				{leftLinks.map(({ href, label }) => (
					<span class="h-full flex items-start pt-1.5" class:list={{ 'border-b-4 border-medium-gray': isActive(href, currentPath) }}>
						<a href={href} aria-current={isActive(href, currentPath) ? 'page' : null} class="text-shadow-lg transition-all duration-200 hover:scale-[1.08] hover:text-shadow-lg/20">{label}</a>
					</span>
				))}
			</div>
			<div></div>
			<div class="flex items-center justify-center gap-6 max-lg:hidden">
				{rightLinks.map(({ href, label }) => (
					<span class="h-full flex items-start pt-1.5" class:list={{ 'border-b-4 border-charcoal': isActive(href, currentPath) }}>
						<a href={href} aria-current={isActive(href, currentPath) ? 'page' : null} class="text-shadow-lg transition-all duration-200 hover:scale-[1.08] hover:text-shadow-lg/20">{label}</a>
					</span>
				))}
			</div>
		</div>
	</div>
</nav>
<button
	id="burger-btn"
	class="hidden max-lg:flex fixed right-4 top-7 z-[60] -translate-y-1/2 items-center justify-center w-12 h-12 text-dark-gray cursor-pointer"
	aria-controls="mobile-menu"
	aria-expanded="false"
	aria-label="Open menu"
>
	<Hamburger class="w-7 h-7" />
</button>

<MobileMenu currentPath={currentPath} />

<script>
import { gsap } from 'gsap'

const socialRow = document.querySelector('.social-row') as HTMLElement | null
const logo = document.getElementById('logo-link') as HTMLElement | null
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
if (socialRow && logo && !reducedMotion) {
	const rowHeight = socialRow.offsetHeight
	gsap.set(logo, { y: rowHeight > 0 ? -28 : 0, scale: rowHeight > 0 ? 1 : 0.55 })
	let isScrolled = false

	const update = () => {
		const shouldBeScrolled = window.scrollY >= socialRow.offsetHeight
		if (shouldBeScrolled !== isScrolled) {
			isScrolled = shouldBeScrolled
			gsap.to(logo, {
				y: isScrolled ? 0 : -28,
				scale: isScrolled ? 0.55 : 1,
				duration: 0.4,
				ease: 'back.out(1.7)',
				overwrite: 'auto',
			})
		}
	}

	update()
	window.addEventListener('scroll', update, { passive: true })
	window.addEventListener('resize', update, { passive: true })
}

const burgerBtn = document.getElementById('burger-btn') as HTMLElement | null
const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null
const inertTargets = [
	document.getElementById('skip-link'),
	document.getElementById('main-nav'),
	document.querySelector('main'),
	document.querySelector('footer'),
].filter((el): el is HTMLElement => el !== null)

if (burgerBtn && mobileMenu) {
	let isOpen = false
	const svg = burgerBtn.querySelector('svg')
	const topPath = svg?.querySelector('.burger-top')
	const midPath = svg?.querySelector('.burger-mid')
	const botPath = svg?.querySelector('.burger-bot')
	const children = mobileMenu.querySelectorAll('a')
	const firstLink = children[0] as HTMLAnchorElement | undefined

	const setInert = (value: boolean) => {
		for (const el of inertTargets) el.inert = value
	}

	const openMenu = () => {
		if (isOpen) return
		isOpen = true
		burgerBtn.setAttribute('aria-expanded', 'true')
		burgerBtn.setAttribute('aria-label', 'Close menu')

		if (topPath) gsap.to(topPath, { attr: { d: 'M5 5 L19 19' }, duration: 0.3, ease: 'back.out(1.5)' })
		if (midPath) gsap.to(midPath, { opacity: 0, duration: 0.2 })
		if (botPath) gsap.to(botPath, { attr: { d: 'M19 5 L5 19' }, duration: 0.3, ease: 'back.out(1.5)' })
		gsap.to(burgerBtn, { color: '#fff', duration: 0.2 })

		gsap.set(children, { opacity: 0, y: 20 })
		mobileMenu.classList.remove('invisible', 'pointer-events-none')
		const tl = gsap.timeline()
		tl.set(mobileMenu, { transformOrigin: 'top right' })
			.fromTo(mobileMenu, { opacity: 0, scale: 0.3, borderRadius: '48px' }, { opacity: 1, duration: 0.5, ease: 'power2.out' }, 0)
			.to(mobileMenu, { scale: 1, borderRadius: '0px', duration: 0.5, ease: 'back.out(1.7)' }, 0)
		gsap.to(children, { opacity: 1, y: 0, duration: 0.3, stagger: 0.06, ease: 'power2.out' })

		setInert(true)
		firstLink?.focus()
	}

	const closeMenu = () => {
		if (!isOpen) return
		isOpen = false
		burgerBtn.setAttribute('aria-expanded', 'false')
		burgerBtn.setAttribute('aria-label', 'Open menu')

		if (topPath) gsap.to(topPath, { attr: { d: 'M3 6 L21 6' }, duration: 0.3, ease: 'back.out(1.5)' })
		if (midPath) gsap.to(midPath, { opacity: 1, duration: 0.2 })
		if (botPath) gsap.to(botPath, { attr: { d: 'M3 18 L21 18' }, duration: 0.3, ease: 'back.out(1.5)' })
		gsap.to(burgerBtn, { color: '#333', duration: 0.2 })

		gsap.to(mobileMenu, {
			borderRadius: '48px',
			opacity: 0,
			scale: 0.7,
			transformOrigin: 'top right',
			duration: 0.2,
			ease: 'power2.out',
			onComplete: () => mobileMenu.classList.add('invisible', 'pointer-events-none'),
		})

		setInert(false)
		burgerBtn.focus()
	}

	burgerBtn.addEventListener('click', () => (isOpen ? closeMenu() : openMenu()))

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && isOpen) {
			closeMenu()
			return
		}
		if (e.key === 'Tab' && isOpen) {
			if (children.length === 0) return
			const first = children[0]
			const last = children[children.length - 1]
			if (e.shiftKey && document.activeElement === first) {
				last.focus()
				e.preventDefault()
			} else if (!e.shiftKey && document.activeElement === last) {
				first.focus()
				e.preventDefault()
			}
		}
	})
}
</script>
