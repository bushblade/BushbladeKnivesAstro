---
import Facebook from "./icons/Facebook.astro";
import Instagram from "./icons/Instagram.astro";
import Twitter from "./icons/Twitter.astro";
import YouTube from "./icons/YouTube.astro";
import Logo from "./Logo.astro";
---

<nav
	id="main-nav"
	class="bg-olive text-dark-gray sticky top-0 z-50 overflow-hidden"
>
	<div
		class="absolute inset-0 flex items-center justify-center pointer-events-none"
	>
		<a href="/" id="logo-link" class="pointer-events-auto block w-80">
			<Logo class="w-full h-auto" />
		</a>
	</div>

	<div class="social-row h-16 overflow-hidden">
		<div class="flex items-center h-full px-4">
			<div class="flex items-center gap-3">
				<a
					href="https://www.facebook.com/Bushbladehandmadeknives/"
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-facebook transition-colors"
					aria-label="Facebook"
				>
					<Facebook class="w-4 h-4" />
				</a>
				<a
					href="https://www.instagram.com/bushblade/"
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-instagram transition-colors"
					aria-label="Instagram"
				>
					<Instagram class="w-4 h-4" />
				</a>
				<a
					href="https://x.com/Bushblade"
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-twitter transition-colors"
					aria-label="Twitter / X"
				>
					<Twitter class="w-4 h-4" />
				</a>
				<a
					href="https://www.youtube.com/@bushbladehandmadeknives2528"
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-youtube transition-colors"
					aria-label="YouTube"
				>
					<YouTube class="w-4 h-4" />
				</a>
			</div>
		</div>
	</div>

	<div class="h-16 overflow-hidden">
		<div
			class="grid grid-cols-[1fr_320px_1fr] items-center h-full text-xl italic tracking-wider"
		>
			<div class="flex items-center justify-center gap-6">
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/contact">Contact</a>
				<a href="/posts">Posts</a>
			</div>
			<div></div>
			<div class="flex items-center justify-center gap-6">
				<a href="/knives/woodlore-clone">
					Woodlore Clone
				</a>
				<a href="/knives/midi">
					Midi
				</a>
			</div>
		</div>
	</div>
</nav>

<style>
	nav {
		height: 128px;
		transition: height 300ms;
	}
	nav.scrolled {
		height: 64px;
	}
	.social-row {
		transition: height 300ms, opacity 300ms;
	}
	nav.scrolled .social-row {
		height: 0;
		opacity: 0;
	}
	nav a:not(#logo-link) {
		filter: drop-shadow(0 1px 1px rgba(0,0,0,0.3));
		transition: filter 200ms ease, transform 200ms ease;
	}
	nav a:not(#logo-link):hover {
		transform: scale(1.08);
		filter: drop-shadow(0 2px 4px rgba(0,0,0,0.35));
	}
</style>

<script>
	import { gsap } from "gsap";

	const nav = document.getElementById("main-nav");
	const logo = document.getElementById("logo-link");
	if (nav && logo) {
		let isScrolled = false;

		const update = () => {
			const shouldBeScrolled = window.scrollY > 50;
			if (shouldBeScrolled !== isScrolled) {
				isScrolled = shouldBeScrolled;
				nav.classList.toggle("scrolled", isScrolled);

				gsap.to(logo, {
					scale: isScrolled ? 0.6 : 1,
					duration: 0.4,
					ease: "back.out(1.7)",
					overwrite: "auto",
				});
			}
		};

		update();
		window.addEventListener("scroll", update, { passive: true });
	}
</script>
