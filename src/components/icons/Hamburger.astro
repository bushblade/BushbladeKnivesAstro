---
interface Props {
	class?: string
}

const { class: className } = Astro.props
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
>
	<path class="burger-top" d="M3 6 L21 6" stroke-linecap="round" />
	<path class="burger-mid" d="M3 12 L21 12" stroke-linecap="round" />
	<path class="burger-bot" d="M3 18 L21 18" stroke-linecap="round" />
</svg>
