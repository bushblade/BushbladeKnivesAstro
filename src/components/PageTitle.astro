---
interface Props {
	pageTitle: string
	tagline?: string
	noMargin?: boolean
}

const { pageTitle, tagline, noMargin = false } = Astro.props
---

<div class="text-center" class:list={{ 'mt-16 mb-24': !noMargin }}>
	<h1 class="font-['Bilbo'] text-5xl inline-block border-b-[3px] border-olive px-8 leading-[0.9]">
		{pageTitle}
		{tagline ? (
			<span class="font-sans italic text-[1.4rem] bg-off-white px-[0.2rem] inline-block translate-y-4">&nbsp;{tagline}</span>
		) : null}
	</h1>
</div>

<script>
import { gsap } from 'gsap'

const title = document.querySelector('h1') as HTMLElement | null
const tagline = title?.querySelector('span') as HTMLElement | null | undefined

if (title) {
	gsap.from(title, {
		x: -160,
		opacity: 0,
		duration: 0.8,
		ease: 'power2.out',
	})
}

if (tagline) {
	gsap.from(tagline, {
		x: -160,
		opacity: 0,
		duration: 0.6,
		delay: 0.4,
		ease: 'power2.out',
	})
}
</script>
