---
import { Image } from 'astro:assets'
import { imageFormat } from '../utils/image'

interface Props {
	image: ImageMetadata
	alt: string
}

const { image, alt } = Astro.props
---

<div class="bg-off-white">
	<Image
		src={image}
		alt={alt}
		class="w-full animate-fade-in"
		layout="full-width"
		loading="eager"
		format={imageFormat}
	/>
</div>
