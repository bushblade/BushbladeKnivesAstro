---
import { Image } from 'astro:assets'

interface Props {
	image: ImageMetadata
	alt: string
}

const format = import.meta.env.PROD ? 'avif' : undefined
const { image, alt } = Astro.props
---

<div class="bg-off-white">
	<Image
		src={image}
		alt={alt}
		class="w-full animate-fade-in"
		layout="full-width"
		loading="eager"
		format={format}
	/>
</div>

<style>
	@keyframes fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	.animate-fade-in {
		animation: fade-in 0.4s ease-out;
	}
</style>
