---

import { leftLinks, rightLinks } from '../data/links'

const currentYear = new Date().getFullYear()
const socialLinks = [
	{ href: 'https://www.facebook.com/Bushbladehandmadeknives/', label: 'Facebook' },
	{ href: 'https://www.instagram.com/bushblade/', label: 'Instagram' },
	{ href: 'https://x.com/Bushblade', label: 'Twitter / X' },
	{
		href: 'https://www.youtube.com/@bushbladehandmadeknives2528',
		label: 'YouTube',
	},
]
---

<footer class="bg-olive-gray text-off-white border-b-8 border-olive-light leading-snug">
	<div class="mx-auto max-w-6xl px-4 py-6 md:px-8 md:py-8 lg:px-12 lg:py-8">
		<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
			<div class="text-center">
				<h3 class="shadow-underline-olive text-lg font-semibold italic inline-block">
					Pages
				</h3>
				<ul class="mt-4 space-y-2">
					{leftLinks.map(({ href, label }) => (
						<li>
							<a href={href} class="transition-all hover:shadow-underline-olive">{label}</a>
						</li>
					))}
				</ul>
			</div>
			<div class="text-center">
				<h3 class="shadow-underline-olive text-lg font-semibold italic inline-block">
					Knives
				</h3>
				<ul class="mt-4 space-y-2">
					{rightLinks.map(({ href, label }) => (
						<li>
							<a href={href} class="transition-all hover:shadow-underline-olive">{label}</a>
						</li>
					))}
				</ul>
			</div>
			<div class="text-center">
				<h3 class="shadow-underline-olive text-lg font-semibold italic inline-block">
					Social Media
				</h3>
				<ul class="mt-4 space-y-2">
					{socialLinks.map(({ href, label }) => (
						<li>
							<a
								href={href}
								target="_blank"
								rel="noopener noreferrer"
								class="transition-all hover:shadow-underline-olive"
							>
								{label}
							</a>
						</li>
					))}
				</ul>
			</div>
			<div class="text-center">
				<p>
					<a
						href="mailto:bushblade@gmail.com"
						class="transition-all hover:shadow-underline-olive"
					>
						bushblade@gmail.com
					</a>
				</p>
			</div>
		</div>
	</div>
	<div class="px-4 py-4 text-center text-sm md:px-8 lg:px-12">
		All content &copy; {currentYear} Will Adams. Site design and development by
		Will Adams. All images &copy; Lou Adams Photography
	</div>
</footer>
