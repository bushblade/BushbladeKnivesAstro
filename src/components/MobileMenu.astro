---
import { leftLinks, rightLinks } from '../data/links'
import Facebook from './icons/Facebook.astro'
import Instagram from './icons/Instagram.astro'
import Twitter from './icons/Twitter.astro'
import YouTube from './icons/YouTube.astro'

const currentPath = Astro.props.currentPath as string

const socialLinks = [
	{
		href: 'https://www.facebook.com/Bushbladehandmadeknives/',
		icon: Facebook,
		hoverColor: 'hover:text-facebook',
		ariaLabel: 'Facebook',
	},
	{
		href: 'https://www.instagram.com/bushblade/',
		icon: Instagram,
		hoverColor: 'hover:text-instagram',
		ariaLabel: 'Instagram',
	},
	{
		href: 'https://x.com/Bushblade',
		icon: Twitter,
		hoverColor: 'hover:text-twitter',
		ariaLabel: 'Twitter / X',
	},
	{
		href: 'https://www.youtube.com/@bushbladehandmadeknives2528',
		icon: YouTube,
		hoverColor: 'hover:text-youtube',
		ariaLabel: 'YouTube',
	},
]
---

<div
	id="mobile-menu"
	class="fixed inset-0 z-50 bg-charcoal/90 invisible pointer-events-none"
>
	<div class="flex flex-col items-center justify-center h-full">
		<div class="flex flex-col items-center gap-8 text-white text-2xl italic tracking-wider">
			{leftLinks.map(({ href, label }) => (
				<a href={href} class="hover:text-olive transition-colors underline-offset-4 decoration-2" class:list={{ 'underline': currentPath === href }}>{label}</a>
			))}
			{rightLinks.map(({ href, label }) => (
				<a href={href} class="hover:text-olive transition-colors underline-offset-4 decoration-2" class:list={{ 'underline': currentPath === href }}>{label}</a>
			))}
		</div>

		<div class="flex items-center gap-6 mt-10">
			{socialLinks.map(({ href, icon: Icon, ariaLabel }) => (
				<a
					{href}
					target="_blank"
					rel="noopener noreferrer"
					class="text-white hover:text-olive transition-colors"
					aria-label={ariaLabel}
				>
					<Icon class="w-6 h-6" />
				</a>
			))}
		</div>
	</div>
</div>
