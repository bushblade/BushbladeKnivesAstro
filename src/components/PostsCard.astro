---
import type { CollectionEntry } from 'astro:content'
import FadeImage from './FadeImage.astro'
import Calendar from './icons/Calendar.astro'
import User from './icons/User.astro'

interface Props {
	post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { title, date, author, image, excerpt } = post.data
const formattedDate = date.toLocaleDateString('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
})
---

<a
	href={`/posts/${post.id}`}
	class="group block rounded-[0.2rem] bg-off-white shadow-[-1px_10px_45px_0px_rgba(0,0,0,0.2)] overflow-hidden transition-all duration-300 ease-out hover:-translate-y-2.5 hover:scale-[1.02] hover:shadow-[-1px_15px_45px_0px_rgba(0,0,0,0.3)]"
>
	<div class="relative border-b-[5px] border-olive after:content-[''] after:border-r-8 after:border-b-8 after:border-t-8 after:border-l-8 after:border-r-olive after:border-b-olive after:border-t-transparent after:border-l-transparent after:rounded-sm after:absolute after:-bottom-3 after:left-1/2 after:-ml-2 after:rotate-45">
		<div class="h-48 overflow-hidden">
			<FadeImage src={image} alt={title} layout="full-width" class="h-48 w-full object-cover" />
		</div>
		<div class="absolute bottom-0 left-0 right-0 flex items-center min-h-16 px-4 bg-linear-to-t from-black/60 to-transparent">
			<h2 class="text-white text-3xl leading-tight">{title}</h2>
		</div>
	</div>
	<div class="p-4 mb-8">
		<p>{excerpt}</p>
	</div>
	<div class="grid grid-cols-2 px-4 pt-4 pb-4 text-[dimgrey] italic">
		<div class="flex items-center gap-1">
			<User class="w-4 h-4" />
			<span>{author}</span>
		</div>
		<div class="flex items-center gap-1">
			<Calendar class="w-4 h-4" />
			<span>{formattedDate}</span>
		</div>
	</div>
</a>
